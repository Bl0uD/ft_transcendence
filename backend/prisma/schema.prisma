generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ChannelType {
  PUBLIC
  PRIVATE
  PROTECTED // Nécessite un mot de passe
  DIRECT    // Pour les messages privés 1-vs-1 et le chat IA
}

enum ChannelRole {
  OWNER
  ADMIN
  MEMBER
}

// Nouveau : Gère l'état de présence de l'utilisateur via WebSockets
enum UserStatus {
  ONLINE
  OFFLINE
  IN_GAME
}

// --- MODÈLES ---

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  nickname  String?  // NOUVEAU : Pseudonyme d'affichage libre, sans contrainte d'unicité
  password  String?  // Rendu optionnel pour le Bot IA et OAuth 42
  
  // NOUVEAU : L'avatar n'est plus optionnel (plus de '?'), il a une image par défaut
  avatar    String   @default("/assets/default-avatar.png")

  // --- NOUVEAU : OAUTH2 API 42 ---
  fortyTwoId String?  @unique 

  // --- NOUVEAU : DOUBLE AUTHENTIFICATION (2FA) ---
  twoFactorSecret      String?  
  isTwoFactorEnabled   Boolean  @default(false) 
 is2faAuthenticated    Boolean  @default(false)

  // --- NOUVEAU : STATUT DE PRÉSENCE ---
  status    UserStatus @default(OFFLINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations Sociales
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")

  // Relations Chat
  channelMemberships ChannelMember[]
  messages           Message[]
  posts 			 Post[]
  likes				 Like[]
  comments			 Comment[]
}

model Friendship {
  id        Int              @id @default(autoincrement())
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  requesterId Int
  requester   User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId Int
  addressee   User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Channel {
  id        Int         @id @default(autoincrement())
  name      String?     // Nom du salon (ex: "ai-chat-1" ou "Salon Général")
  type      ChannelType @default(PUBLIC)
  password  String?     // Hashé si type == PROTECTED
  userLimit Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  members  ChannelMember[]
  messages Message[]

  @@index([name]) // Accélère la recherche dans saveMessage()
}

model ChannelMember {
  id   Int         @id @default(autoincrement())
  role ChannelRole @default(MEMBER)

  isBanned   Boolean   @default(false)
  mutedUntil DateTime? // Si dans le futur, l'utilisateur est muet

  joinedAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId Int
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  senderId Int
  sender   User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  channelId Int
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model Post {
  id        Int       @id @default(autoincrement())
  content   String
  imageUrl  String?   // Optionnel pour les posts avec image
  isPublic  Boolean   @default(true) // true = Tous les users, false = Amis uniquement
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  
  likes     Like[]
  comments  Comment[]
}

model Like {
  id     Int  @id @default(autoincrement())
  userId Int
  postId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId]) // Empêche de liker 2 fois le même post
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}