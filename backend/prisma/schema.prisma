generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ChannelType {
  PUBLIC
  PRIVATE
  PROTECTED // Nécessite un mot de passe
  DIRECT    // Pour les messages privés 1-vs-1 et le chat IA
}

enum ChannelRole {
  OWNER
  ADMIN
  MEMBER
}

// --- MODÈLES ---

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String?  // Rendu optionnel pour le Bot IA et OAuth 42
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations Sociales
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")

  // Relations Chat
  channelMemberships ChannelMember[]
  messages           Message[]
}

model Friendship {
  id        Int              @id @default(autoincrement())
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  requesterId Int
  requester   User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId Int
  addressee   User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Channel {
  id        Int         @id @default(autoincrement())
  name      String?     // Nom du salon (ex: "ai-chat-1" ou "Salon Général")
  type      ChannelType @default(PUBLIC)
  password  String?     // Hashé si type == PROTECTED
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  members  ChannelMember[]
  messages Message[]

  @@index([name]) // Accélère la recherche dans saveMessage()
}

model ChannelMember {
  id   Int         @id @default(autoincrement())
  role ChannelRole @default(MEMBER)

  isBanned   Boolean   @default(false)
  mutedUntil DateTime? // Si dans le futur, l'utilisateur est muet

  joinedAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId Int
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  senderId Int
  sender   User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  channelId Int
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}